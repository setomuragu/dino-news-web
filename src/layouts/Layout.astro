---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="description" content="The latest dinosaur news, powered by AI." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="min-h-screen flex flex-col bg-gray-900 text-gray-100">
		<div class="flex-grow">
			<slot />
		</div>
		<footer class="bg-gray-950 border-t border-gray-800 mt-12 py-8 text-center text-gray-400">
			<div class="container mx-auto px-4">
				<p class="mb-2">Built by yorocorome</p>
				<div class="flex justify-center gap-4 text-sm">
					<a href="mailto:yorocorome@gmail.com" class="hover:text-blue-400 transition-colors">
						yorocorome@gmail.com
					</a>
					<span class="text-gray-600">|</span>
					<a href="https://github.com/yorocorome" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">
						GitHub
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>
