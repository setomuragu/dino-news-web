---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

// Cloudflare Web Analytics 토큰.
// 비밀값이 아니라 페이지 소스에 그대로 노출되는 공개 식별자입니다.
// 발급: Cloudflare 대시보드 → Analytics & Logs → Web Analytics → Add a site
const CF_BEACON_TOKEN = '799be1aaad104198a31ed68efd5c7c6e';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="description" content="The latest dinosaur news, powered by AI." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{import.meta.env.PROD && CF_BEACON_TOKEN && (
			<script
				is:inline
				defer
				src="https://static.cloudflareinsights.com/beacon.min.js"
				data-cf-beacon={JSON.stringify({ token: CF_BEACON_TOKEN })}
			/>
		)}
	</head>
	<body class="min-h-screen flex flex-col bg-gray-900 text-gray-100">
		<div class="flex-grow">
			<slot />
		</div>
		<footer class="bg-gray-950 border-t border-gray-800 mt-12 py-8 text-center text-gray-400">
			<div class="container mx-auto px-4">
				<p class="mb-2">Built by yorocorome</p>
				<div class="flex justify-center gap-4 text-sm">
					<a href="mailto:yorocorome@gmail.com" class="hover:text-blue-400 transition-colors">
						yorocorome@gmail.com
					</a>
					<span class="text-gray-600">|</span>
					<a href="https://github.com/yorocorome" target="_blank" rel="noopener noreferrer" class="hover:text-blue-400 transition-colors">
						GitHub
					</a>
				</div>
			</div>
		</footer>
	</body>
</html>
